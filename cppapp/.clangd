CompileFlags:
  # Add flags to force MSVC compatibility
  Add:
    # 1. Vital: Tell clang to act like cl.exe (parses /I, /D, etc.)
    - "--driver-mode=cl"

    # 2. Enable MSVC-specific language extensions (like __stdcall, __declspec)
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-fms-compatibility-version=19.30" # Optional: Mimic VS 2022 (19.30+)

    # 3. Handle Template Parsing (MSVC is lazier than Clang)
    - "-fdelayed-template-parsing"

    # 4. Define standard MSVC macros if missing
    - "-D_CRT_SECURE_NO_WARNINGS"
    - "-D_WIN32_WINNT=0x0A00" # Target Windows 10/11

    # 5. Optional: Set C++ Standard if your build system doesn't (pick one)
    # - "/std:c++17"
    - "/std:c++20"

  # Remove flags that might confuse clangd if they come from a GCC-based build system
  Remove:
    - "-W*"
    - "-fno-rtti"

# Help clangd find the compiler executable if it needs to query system paths
# (Useful if you are using MinGW or a specific Clang setup, less critical for pure MSVC)
# CompileFlags:
#   Compiler: "cl.exe"
